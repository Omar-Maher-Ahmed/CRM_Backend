              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["graphql"]
            },
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation {\n  createUser(input: {\n    fullName: \"Omar Maher\",\n    email: \"omar.new@example.com\",\n    phone: \"01122334466\",\n    password: \"MySecretPassword\",\n    salary: 5000,\n    roleId: 3\n  }) {\n    id\n    fullName\n    email\n    role {\n      name\n    }\n  }\n}"
              }
            }
          }
        },
